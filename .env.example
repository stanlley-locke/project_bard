# Project Bard - Environment Variables
# Copy this file to .env and modify as needed
# These override values in config.py

# Device Configuration
BARD_DEVICE=cuda          # cuda or cpu
BARD_DTYPE=float16        # float16 or bfloat16

# Training
BARD_BATCH_SIZE=8
BARD_MAX_STEPS=5000
BARD_LEARNING_RATE=1.5e-4

# Weights & Biases
BARD_USE_WANDB=true
BARD_WANDB_PROJECT=project-bard
BARD_WANDB_ENTITY=your-entity-name

# API Server
BARD_API_HOST=0.0.0.0
BARD_API_PORT=8000
BARD_RATE_LIMIT=30        # requests per minute per IP

WANDB_MODE=online